{
  "name": "team-forge-android",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <=26.x"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "npm run lint && npm test",
    "build:android": "gradlew.bat :app:assembleDebug",
    "verify:integrations": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_integrations.ps1",
    "verify:gemini": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_integrations.ps1 -ProbeGemini",
    "verify:serial": "powershell -ExecutionPolicy Bypass -File ./scripts/verify_integrations.ps1 -ProbeSerialAdapters",
    "sync": "node scripts/auto_sync.js --once",
    "sync:watch": "node scripts/auto_sync.js",
    "sync:silent": "wscript.exe ./scripts/start_sync_daemon.vbs",
    "sync:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/auto_sync.ps1",
    "sync:status": "git status && git log -n 3 --oneline",
    "bridge:termux": "powershell -ExecutionPolicy Bypass -File ./scripts/start_termux_bridge.ps1",
    "connect": "powershell -ExecutionPolicy Bypass -File ./scripts/connect_workflows.ps1"
  },
  "description": "Team Forge Android diagnostics tooling",
  "main": "index.js",
  "directories": { "test": "test" },
  "repository": { "type": "git", "url": "git+https://github.com/newsteps4them-arch/ForgeDiagnostics.git" },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": { "url": "https://github.com/newsteps4them-arch/ForgeDiagnostics/issues" },
  "homepage": "https://github.com/newsteps4them-arch/ForgeDiagnostics#readme",
  "devDependencies": {
    "@google/genai": "^2.19.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
